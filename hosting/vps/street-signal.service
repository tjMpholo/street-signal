[Unit]
Description=Street Signal dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=streetsignal
Group=streetsignal
WorkingDirectory=/opt/street-signal/current
ExecStart=/opt/street-signal/current/StreetSignal.Dashboard
EnvironmentFile=/etc/street-signal/environment
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5287
Environment=Security__DataProtectionPath=/var/lib/street-signal/keys
Environment=Hosting__ManagedTls=true
Environment=AllowedHosts=street-signal.duetonetechsolutions.com;localhost;127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=street-signal
StateDirectoryMode=0700
ReadWritePaths=/var/lib/street-signal
UMask=0077

[Install]
WantedBy=multi-user.target

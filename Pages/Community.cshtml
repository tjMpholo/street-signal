@page
@model StreetSignal.Dashboard.Pages.CommunityModel
@{ViewData["Title"]="Community";}
<partial name="_LiveSidebar" model='@(("Community",Model.Area))'/>
<div class="main"><header>Workspace <span>/</span> Community <small>FIREBASE DATA</small></header><main><div class="heading"><div><div class="eyebrow">STREET SIGNAL · OPERATIONS</div><h1>Community</h1><p>See how neighbours are showing up for each other.</p></div>@if(Model.Areas.Length>0){<form method="get"><label for="area">Viewing area</label><select id="area" name="Area">@foreach(var a in Model.Areas){<option selected="@(a==Model.Area)">@a</option>}</select><button class="subtle">Refresh</button></form>}</div>
@if(Model.Areas.Length==0){<section class="panel"><h2>No areas yet</h2><p>Areas appear as residents submit reports.</p></section>}
@if(Model.Error!=null){<div class="banner" role="alert">@Model.Error</div>}
@if(Model.Data is {} data){
<div class="banner">Active posts are open and not expired. All times SAST. @if(data.PilotCount>0){<strong>Includes @data.PilotCount pilot posts.</strong>}</div>
<div class="grid"><section class="panel"><h2>Community activity</h2><p>Active posts by sector</p>@{var total=data.Sectors.Values.Sum();var water=data.Sectors.GetValueOrDefault("water");var colors=new[]{"#347d68","#ddbf6d","#79a6b9","#a796bd","#8fa76d"};var cumulative=0;var index=0;var stops=new List<string>();foreach(var sector in data.Sectors.OrderBy(x=>x.Key)){var start=total==0?0:cumulative*100/total;cumulative+=sector.Value;var end=total==0?0:cumulative*100/total;stops.Add($"{colors[index++%colors.Length]} {start}% {end}%");}var gradient=string.Join(",",stops);}@if(total>0){<div class="donut" style="background:conic-gradient(@gradient)"><div><strong>@total</strong><small>active posts</small></div></div><div class="sectorlegend">@{var legendIndex=0;}@foreach(var sector in data.Sectors.OrderBy(x=>x.Key)){<span><i style="background:@colors[legendIndex++%colors.Length]"></i>@sector.Key · @sector.Value</span>}</div>}@foreach(var sector in new[]{"food","energy","water","transport","prepare"}){var count=data.Sectors.GetValueOrDefault(sector);<div class="sector"><span>@sector</span><div><i style="width:@(total==0?0:count*100/total)%"></i></div><b>@count</b></div>}@if(total==0){<p>No active community posts yet.</p>}</section>
<section class="panel"><h2>Group buys</h2><p>Active neighbourhood groups</p>@foreach(var post in data.Groups){<article class="post"><small>@post.Sector @if(post.Pilot){<span> · Pilot data</span>}</small><h3>@post.Title</h3><p>@post.Members joined @(post.Target is {} target?$"of {target} needed":"· No target set")</p>@if(post.Target is {} goal){<progress max="@goal" value="@Math.Min(goal,post.Members)">@post.Members of @goal</progress>}</article>}@if(data.Groups.Length==0){<p>No active group buys in this area.</p>}</section>
<section class="panel"><h2>Latest water quality checks</h2><p>Newest 20 checks, including closed posts</p>@foreach(var post in data.WaterChecks){<article class="post"><span class="status @(post.Quality=="clear"?"confirmed":"suspected")">@(string.IsNullOrWhiteSpace(post.Quality)?"Quality not specified":post.Quality)</span>@if(post.Pilot){<small> · Pilot data</small>}<h3>@post.Title</h3><p>@post.Place</p><small>@post.Created.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm") SAST</small></article>}@if(data.WaterChecks.Length==0){<p>No water quality checks yet.</p>}</section>
<section class="panel"><h2>Road & access problems</h2><p>Newest 20 active access reports</p>@foreach(var post in data.Access){<article class="post"><h3>@post.Title</h3><p>@post.Place</p><small>@post.Created.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm") SAST @(post.Pilot?"· Pilot data":"")</small></article>}@if(data.Access.Length==0){<p>No active access problems reported.</p>}</section></div>
}
@if(Model.ReadinessError!=null){<div class="banner" role="alert">@Model.ReadinessError</div>}
@if(Model.Readiness is {} readiness){<div class="grid"><section class="panel"><h2>Emergency readiness</h2><p>Consented households only · Each home counted once per need category</p>@foreach(var kind in new[]{"power_equipment","mobility","water","young_or_old","other"}){<div class="row"><span>@CommunityModel.NeedLabel(kind)</span><b>@readiness.Needs.GetValueOrDefault(kind) homes</b></div>}@if(Model.Data!=null){<p>@Model.Data.Helpers active offers of emergency help</p>}</section><section class="panel"><h2>Warnings acted on</h2><p>Consented household forecasts issued in the last 56 days</p><div class="empty"><h3>@(readiness.Issued==0?"No forecasts issued yet":$"{readiness.Acted*100.0/readiness.Issued:0.#}% acted on")</h3><p>@readiness.Acted acted on · @readiness.Issued issued</p></div></section></div>}
<footer>Street Signal <span>Private household information shown only as totals</span></footer></main></div>


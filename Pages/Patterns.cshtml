@page
@model StreetSignal.Dashboard.Pages.PatternsModel
@{ViewData["Title"]="Patterns";}
<partial name="_LiveSidebar" model='@(("Patterns",Model.Area))'/>
<div class="main"><header>Workspace <span>/</span> Patterns <small>FIREBASE DATA</small></header><main><div class="heading"><div><div class="eyebrow">STREET SIGNAL · OPERATIONS</div><h1>Patterns</h1><p>Understand when disruptions happen and how long they last.</p></div>@if(Model.Areas.Length>0){<form method="get"><label for="area">Viewing area</label><select id="area" name="Area">@foreach(var a in Model.Areas){<option selected="@(a==Model.Area)">@a</option>}</select><button class="subtle">Refresh</button></form>}</div>
@if(Model.Areas.Length==0){<section class="panel"><h2>No areas yet</h2><p>Areas appear as residents submit reports.</p></section>}
@if(Model.Error!=null){<div class="banner" role="alert">@Model.Error</div>}
@if(Model.Data is {} data){
<div class="banner">Last 56 days · SAST · @data.Count reports @if(data.PilotCount>0){<strong> · Includes @data.PilotCount pilot reports</strong>}</div>
<section class="panel"><h2>When disruptions happen</h2><p>Problem reports by weekday and hour. Restoration-only reports are excluded. Hover or focus a cell for its count.</p>@{var max=0;foreach(var count in data.Heatmap)max=Math.Max(max,count);} <div class="heatmap"><div class="heatgrid" role="table" aria-label="Problem reports by SAST weekday and hour">@for(var d=0;d<7;d++){<div class="heatrow" role="row"><span role="rowheader">@(new[]{"Mon","Tue","Wed","Thu","Fri","Sat","Sun"}[d])</span>@for(var h=0;h<24;h++){var count=data.Heatmap[d,h];var level=count==0?0:Math.Clamp((int)Math.Ceiling(count*4.0/Math.Max(1,max)),1,4);var label=$"{new[]{"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"}[d]}, {h:00}:00: {count} reports";<div class="heat level@(level)" role="cell" tabindex="0" title="@label" aria-label="@label"></div>}</div>}</div><div class="axis"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:00</span></div></div><p style="margin-top:20px">Pale cells: no reports · Darker cells: more reports · Maximum: @max</p>@if(data.Count==0){<p>No reports in this area in the last 56 days.</p>}</section>
<div class="grid"><section class="panel"><h2>Typical outage length</h2><p>Median duration of restored problem reports</p>@foreach(var service in data.Medians){<div class="row"><span>@service.Key</span><b>@PatternsModel.Duration(service.Value)</b></div>}</section><section class="panel"><h2>Report types</h2><p>Includes restoration reports · last 56 days</p>@foreach(var type in data.Types.OrderByDescending(x=>x.Value)){<div class="row"><span>@type.Key.Replace('_',' ')</span><b>@type.Value</b></div>}@if(data.Types.Count==0){<p>No report types to show yet.</p>}</section></div>
}
<footer>Street Signal <span>Times in SAST · Manual refresh</span></footer></main></div>

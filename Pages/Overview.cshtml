@page
@model StreetSignal.Dashboard.Pages.OverviewModel
@{ViewData["Title"]="Overview";}
<partial name="_LiveSidebar" model='@(("Overview",Model.Area))'/>
<div class="main"><header>Workspace <span>/</span> Overview <small>FIREBASE DATA</small></header><main><div class="heading"><div><div class="eyebrow">STREET SIGNAL · OPERATIONS</div><h1>Community overview</h1><p>A clearer picture of what your communities need.</p></div>@if(Model.Areas.Length>0){<form method="get"><label for="area">Viewing area</label><select id="area" name="Area">@foreach(var a in Model.Areas){<option selected="@(a==Model.Area)">@a</option>}</select><button class="subtle">Refresh</button></form>}</div>
@if(Model.Areas.Length==0){<section class="panel"><h2>No areas yet</h2><p>Areas will appear as residents set up their homes and submit reports.</p></section>}
@if(Model.Error!=null){<div class="banner" role="alert">@Model.Error</div>}
@if(Model.Data is {} data){
@if(data.PilotReports>0){<div class="banner"><strong>Pilot data included</strong> @data.PilotReports of @data.ReportCount reports in this area are marked as pilot data.</div>}else{<div class="banner">Live Firebase records · @Model.Area · Last 56 days · Times and weeks use SAST</div>}
<section class="stats"><article><p>Open problems now</p><strong>@(data.OpenWater+data.OpenElectricity)</strong><small>@data.OpenWater water · @data.OpenElectricity electricity · Last 12 hours</small></article><article><p>Households reporting</p><strong>@data.Households</strong><small>Distinct household IDs · Last 56 days</small></article><article><p>People affected this week</p><strong>@data.PeopleThisWeek</strong><small>Households counted once within each incident</small></article><article><p>Forecast accuracy</p><strong>@(Model.Forecast?.Accuracy is {} score?score.ToString("0.#")+"%":"—")</strong><small>@(Model.ForecastError??(Model.Forecast?.Answered>0?$"{Model.Forecast.Answered} answered forecasts · Last 56 days":"No consented forecast feedback yet"))</small></article></section>
<div class="grid charts"><section class="panel"><h2>Disruptions over time</h2><p>Grouped incidents by week commencing · Partial weeks at either end</p>@{var max=Math.Max(1,data.Weeks.Max(w=>w.Count));}<div class="bars" role="img" aria-label="Weekly incident counts: @(string.Join(", ",data.Weeks.Select(w=>$"{w.Starting:dd MMM}: {w.Count}")))">@foreach(var week in data.Weeks){<div><small>@week.Count</small><i style="height:@(week.Count*145/max)px"></i><small>@week.Starting.ToString("dd MMM")</small></div>}</div><div class="chartfoot">● Water & electricity incidents <span>Last 56 days</span></div></section><section class="panel"><h2>Reports by service</h2><p>Resident reports in the selected area · Last 56 days</p>@{var total=data.WaterReports+data.ElectricityReports;var percent=total==0?0:data.WaterReports*100/total;}@if(total>0){<div class="donut" style="--percent:@percent%"><div><strong>@total</strong><small>reports</small></div></div><div class="legend">● Water <b>@data.WaterReports</b><span>● Electricity <b>@data.ElectricityReports</b></span></div>}else{<div class="empty"><h3>No reports yet</h3><p>Service totals will appear after residents submit reports.</p></div>}</section></div>
<section class="panel"><div class="panelhead"><div><h2>From insight to action</h2><p>Review resident reports, confirm incidents, and send area alerts.</p></div><a href="/Live?Area=@Uri.EscapeDataString(Model.Area)">Open live reports ↗</a></div></section><p>Open problems count unrestored reports from the last 12 hours. Incidents group the same service and problem within fixed three-hour windows. Weekly people estimates may include the same household in separate incidents. Forecast accuracy weights “partly” as half a correct answer and uses consented feedback only.</p>
}
<footer>Street Signal <span>Built around people. Powered by community.</span><span>Times in SAST</span></footer></main></div>


